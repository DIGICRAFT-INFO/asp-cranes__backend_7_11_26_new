# Dependencies
node_modules/



# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / OS
.DS_Store
Thumbs.db
*.pem

# Uploads (user-generated content — not source code)
uploads/images/*
uploads/videos/*
uploads/documents/*
# Keep the folder structure
!uploads/images/.gitkeep
!uploads/videos/.gitkeep
!uploads/documents/.gitkeep
# Public uploads (local dev storage)
public/uploads/images/*
public/uploads/videos/*
public/uploads/documents/*
!public/uploads/images/.gitkeep
!public/uploads/videos/.gitkeep
!public/uploads/documents/.gitkeep

# Vercel
.vercel
.vercelignore

# IDE
.vscode/
.idea/

# Misc
*.tsbuildinfo
